# Copy this file to .env.local and fill in the values

# MongoDB Atlas (or local: mongodb://127.0.0.1:27017/shop)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shop

# Any long random string: run `openssl rand -base64 32`
JWT_SECRET=

# Razorpay TEST keys: Dashboard > Account & Settings > API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
# Only needed if you set up the webhook (needs a public URL, e.g. ngrok)
RAZORPAY_WEBHOOK_SECRET=

# Protects the admin endpoint and the one-time seed route (choose your own)
ADMIN_KEY=
SEED_KEY=
